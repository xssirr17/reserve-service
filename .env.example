# Application Port (host binding)
APP_PORT=8080

# Spring Profiles for Container
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL Configuration
POSTGRES_DB=reserve
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Database Connection Pool (HikariCP)
# Sizing rule: (instances * DB_POOL_MAX) < postgres max_connections (default 100)
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=15
DB_POOL_CONNECTION_TIMEOUT=5000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_KEEPALIVE_TIME=30000
DB_POOL_INIT_SQL=SET lock_timeout = '5000ms'; SET statement_timeout = '10000ms';

# Redis Configuration & Client Timeouts (Lettuce)
REDIS_PORT=6379
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms

# Threading & Task Schedulers
SCHEDULER_POOL_SIZE=4
TOMCAT_THREADS_MAX=50
TOMCAT_THREADS_MIN_SPARE=10
TOMCAT_ACCEPT_COUNT=50
TOMCAT_MAX_CONNECTIONS=1000
